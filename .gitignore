# ---- Env / secrets ----
.env
.env.*
!.env.example
# The Podman deployment's template. It matches `.env.*` above, so without this it
# would be untrackable - and a deployment template that cannot be committed is a
# deployment template that drifts from the code it configures.
!.env.production.example
*.pem
*.key
!**/testdata/**/*.key

# ---- Editors / OS ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- Local data volumes ----
.data/
storage-local/
tmp/
scratch/

# Recorded parser output, written by PARSER_MODE=fixture. Machine-regenerable,
# and it holds the full extracted text of whatever was uploaded - real
# counterparty agreements on any working install. 15MB of it accumulated here
# untracked, and a single `git add -A` would have put every word of those
# contracts into history permanently.
backend/storage/fixtures/

# ---- Build artifacts ----
*.log
*.tsbuildinfo
frontend/stats.html
# `make openapi` writes this at the repo root; it is generated from the running
# API, so a committed copy is stale the moment a route changes.
openapi.json
# pandoc renders these from the Markdown next to them; the command is at the top
# of each source file. A committed .docx is stale the moment the .md is edited,
# and a binary that nobody can diff is the last place you want the truth to live.
docs/*.docx

# ---- Deployment ----
# scripts/deploy-remote.sh packages the tree into a tarball and unpacks it on the
# target as deploy.tar.gz. Neither belongs in the repository, and the archive is
# large enough to be worth never committing by accident.
deploy.tar.gz
clear-deploy-*.tar.gz
# scripts/deploy.sh moves the development-only compose override aside on a server.
# Covered by `*.local` above, named here so the reason is discoverable.
docker-compose.override.yml.local

# Benchmark artefacts. Reports are build outputs; baselines are committed.
evaluation-results/
