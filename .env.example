# =============================================================================
# Contract Intelligence Platform - Environment Configuration
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Contract Intelligence Platform"
APP_ENV=development                     # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                         # json | console
API_V1_PREFIX=/api/v1
# Comma-separated CORS allowlist (exact origins, no wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Single-organization deployment. The Project is the security boundary (see §1.1).
ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
ORGANIZATION_NAME="IRIS RegTech"

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# -----------------------------------------------------------------------------
# The shared Hackathon database is the target for BOTH local and deployed work;
# the bundled `postgres` container is no longer used. The POSTGRES_* values below
# only still configure that container, which stays in the compose file as an
# offline fallback - nothing reads them once DATABASE_URL points elsewhere.
POSTGRES_USER=cip
POSTGRES_PASSWORD=cip_dev_password
POSTGRES_DB=cip
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Shared Hackathon database (Hackathon-DB-SRV) ----------------------------
# Async driver for the app; the sync driver is derived automatically for Alembic.
#
# THE HOST DEPENDS ON WHERE THE PROCESS RUNS, and the two are mutually exclusive:
#
#   35.154.17.203   public  - reachable from a developer laptop, NOT from the
#                             application VM (no hairpin route back to the peer's
#                             public address)
#   172.15.151.102  private - reachable from the VM, NOT from a laptop
#
# This file is the local-development default, so it carries the public address.
# The deployed .env on the VM must use the private one. Same server, same
# database, same data - only the address differs.
#
# The password must be URL-encoded: `@` becomes `%40`, `#` becomes `%23`, and so
# on, or the DSN parser reads the password as the host. Note that Alembic doubles
# `%` internally (see migrations/env.py) - do not pre-escape it twice here.
#
# NO REAL CREDENTIAL BELONGS IN THIS FILE. It is committed. Copy it to `.env`
# (git-ignored) and fill in the real values there.
#
# ---------------------------------------------------------------------------
# EVERY ENVIRONMENT POINTS AT ONE DATABASE: Hackathon-DB-SRV.
#
#   Public   35.154.17.203:5432   <- use from a laptop
#   Private  172.15.151.102:5432  <- use from the dev server (13.234.93.157)
#   Database team-1     Schema clear (DB_SCHEMA below)
#
# Those two addresses are the SAME PostgreSQL instance, not a copy. Confirm it
# rather than trusting the address:
#
#   select system_identifier from pg_control_system();   -- 7667820444287067012
#
# Local and the dev server therefore share one set of contracts. That is
# deliberate - the `cip_*` tables are maintained by another system and exist
# only here, so a stack pointed anywhere else classifies nothing and every
# document fails with "No clauses are defined for document type".
#
# Do not point an environment at the bundled `postgres` compose service. It
# runs (two services declare `depends_on` on it) but holds no application data,
# and the app only falls back to it when DATABASE_URL is unset - which is what
# makes a missing value look like a working stack with an empty database.
#
# Verify what a running stack actually reached, which is not always what you
# think you configured:
#
#   podman exec cipdemo-backend printenv DATABASE_URL
#   make db-target                  # asserts it is Hackathon-DB-SRV
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://<user>:<url-encoded-password>@35.154.17.203:5432/team-1

# Our tables live in a dedicated schema because `public` in this database is
# already owned by another team's application, which has its own `contracts` and
# `clauses` tables. Leaving this empty would make `create_all` find those, skip
# creating ours, and bind every foreign key to an incompatible integer-keyed
# table. See DatabaseSettings.schema_name.
DB_SCHEMA=cip
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# -----------------------------------------------------------------------------
# Redis (cache + session + rate limit + BullMQ backend)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=0
CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Security / Auth
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_HASH_SCHEME=argon2                 # argon2 | bcrypt
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute

# Seed system administrator (created by `alembic upgrade head` data seed)
SEED_ADMIN_EMAIL=admin@irisregtech.com
SEED_ADMIN_PASSWORD=Abc@1234
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_FORCE_PASSWORD_CHANGE=false

# --- Microsoft Entra ID SSO ("Sign in with Microsoft") ---
#
# Authorization code + PKCE. The browser never holds a Microsoft token: the code
# is exchanged server-side and the id token's signature is verified against the
# tenant's published keys before any identity is trusted.
OIDC_ENABLED=false
OIDC_PROVIDER=microsoft

# Required. Without a tenant the authority falls back to `common`, which accepts
# any Microsoft account in the world including personal ones - so an unset tenant
# is treated as "not configured" rather than silently becoming a public login.
# TENANT is the Directory (tenant) ID - it becomes the path segment of the
# authority URL. CLIENT is the Application (client) ID. Both are GUIDs, so
# transposing them is easy and impossible to spot by eye; the symptom is
# AADSTS90002 ("Tenant '<guid>' not found") at the authorize step. One request
# settles which is which, because only a real directory answers:
#
#   curl https://login.microsoftonline.com/<guid>/v2.0/.well-known/openid-configuration
AZURE_AD_TENANT_ID=06e84b96-907a-4418-ae29-211bfd190e84
AZURE_AD_CLIENT_ID=f72edf57-01e0-4138-aca3-de022cfc0ca2

# Optional. Leave empty for a SPA / public-client registration - PKCE
# authenticates the exchange. Set it only if the app registration is a web app
# with a secret, and keep it out of source control if you do.
AZURE_AD_CLIENT_SECRET=

# Must match a "Web" redirect URI on the app registration *exactly*, including
# scheme, port and trailing path. A mismatch is the single most common cause of
# AADSTS50011 at sign-in.
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback

# Where the backend sends the browser once the session exists. Must be the
# `/auth/callback` route in the SPA.
OIDC_POST_LOGIN_REDIRECT=http://localhost:5173/auth/callback

# Try `prompt=none` first and fall back to the account picker when Entra says it
# needs interaction. Turn off to always show the picker.
OIDC_SILENT_FIRST=true

# Auto-provision a user row on first successful SSO login. The new account gets
# no project memberships - authenticating proves identity, not authorisation.
OIDC_AUTO_PROVISION_USERS=true

# Comma-separated email domains permitted to sign in. Only meaningful on a
# multi-tenant authority; with a pinned tenant, Entra is already the boundary.
OIDC_ALLOWED_EMAIL_DOMAINS=

# -----------------------------------------------------------------------------
# Object storage - local filesystem
#
# MinIO is gone from this stack: no bucket is published and no S3 credential is
# configured anywhere, so `local` is not merely the default but the only storage
# this file can produce. Document bytes are served BY THE API rather than by a
# presigned URL to another host.
#
# The azure / s3 adapters still exist behind `IObjectStorage`; adopting one means
# adding its credentials back here deliberately.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_CONTAINER=contracts
STORAGE_LOCAL_ROOT=/var/lib/cip/storage
STORAGE_SIGNED_URL_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Upload / Validation
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=200
MAX_FILES_PER_UPLOAD=100
# PDF, Word and ZIP. A ZIP is unpacked into one contract per supported member;
# the archive itself never becomes a contract.
ALLOWED_FILE_TYPES=pdf,doc,docx,zip

# DOC/DOCX are converted to PDF at upload and the pipeline only ever sees the
# PDF - evidence highlighting positions boxes against rendered pages, which only
# exist once there is a PDF. The original stays downloadable.
#
# Empty means "find it": PATH first, then the standard install locations.
# LibreOffice does not add itself to PATH on Windows, so a working install looks
# missing without that search. Only Word uploads depend on this; PDF and ZIP-of-
# PDF uploads work with it unset.
LIBREOFFICE_PATH=
CONVERSION_TIMEOUT_SECONDS=180

# Zip-bomb guards. Both are checked against the archive's central directory
# before anything is decompressed.
MAX_ARCHIVE_MEMBERS=500
MAX_ARCHIVE_UNCOMPRESSED_MB=2048
VIRUS_SCAN_ENABLED=false

# Reject a file whose SHA-256 is already in the project.
# Temporarily false while the document pipeline is being iterated on: re-running
# the same test PDF is the workflow, and a rejection stops it. With this off each
# upload creates a new contract and a new job; use replace_existing to add a
# version to the existing contract instead. Set true to restore the guard.
UPLOAD_DUPLICATE_CHECK=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# -----------------------------------------------------------------------------
# Container engine
#
# Podman fails hard on a container-name collision, so every container is prefixed
# with COMPOSE_PROJECT. Change it to run a second copy of the stack side by side,
# or if another project on this machine already uses `cip-*` names.
#
# POSTGRES_MAJOR must match any existing pgdata volume: a server refuses to start
# on a data directory written by a different major version.
# -----------------------------------------------------------------------------
COMPOSE_PROJECT=cip
# Port the frontend container listens on. 5173 with the dev override (Vite);
# set to 8080 when running `-f docker-compose.yml` alone (nginx runtime image).
FRONTEND_TARGET_PORT=5173
POSTGRES_MAJOR=17

# -----------------------------------------------------------------------------
# Parser
#
# Implemented: idoc (default), pymupdf (local fallback), mock (tests).
# Reserved names that raise an actionable error if selected: adi, textract,
# googledocai. Layout analysis goes through the iDoc service below, which wraps the
# Azure Document Intelligence layout model - so no Azure credential lives here.
# Docling is not used by this deployment and is not an accepted value.
# -----------------------------------------------------------------------------
ACTIVE_PARSER=idoc
# fixture | live
#   fixture - replay recorded responses from PARSER_FIXTURE_DIR. Never calls the
#             layout service, so tests, CI and offline development cost nothing and
#             cannot be broken by an outage. The default.
#   live    - call the real service, recording each response as a fixture so the
#             next run can replay it. One network call per unique file, ever.
PARSER_MODE=live
PARSER_FIXTURE_DIR=storage/fixtures/parser
PARSER_RECORD_FIXTURES=true
PARSER_TIMEOUT_SECONDS=900
PARSER_MAX_RETRIES=3

# Where `python -m app.evaluation.cli benchmark` writes its runs, and where the
# Retrieval Quality screen reads them from.
#
# Make it absolute. Both sides default to the *relative* `evaluation-results`,
# resolved against each process's own working directory - so running the CLI from
# `backend/` and the API from the repo root leaves the dashboard reporting "no
# benchmark has been recorded" with the files one directory away and no error to
# explain it.
EVALUATION_RESULTS_DIR=
OCR_ENABLED=true
OCR_ENGINE=tesseract                    # tesseract | azure
TESSERACT_CMD=/usr/bin/tesseract
# Pages with less than this many extractable characters are treated as scanned.
OCR_SCANNED_PAGE_CHAR_THRESHOLD=40

# iDoc layout service (default parser).
# Takes a PDF on a multipart `file` field and returns a ZIP of per-page Document
# Intelligence layout JSON. Preferred over calling Azure directly: the service holds
# the Azure credential, so this application never does.
IDOC_ENDPOINT=https://devidocapi2.iriscarbon.com/pdf/upload-pdf-to-json
# Optional, only if the service is placed behind auth.
IDOC_API_KEY=
IDOC_API_KEY_HEADER=X-API-Key
# Layout analysis of a long agreement is slow, and this is a remote call.
IDOC_TIMEOUT_SECONDS=600
# Never false in production - contract text is uploaded over this connection, and
# the production config guard refuses to start when verification is off.
IDOC_VERIFY_TLS=true

# Azure Document Intelligence (direct call; only for deployments with their own
# Azure resource - ACTIVE_PARSER=adi)

AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
AZURE_DOCINTEL_MODEL=prebuilt-layout

# --- pdf_text_extractor (local layout parser) ---
#
# Set ACTIVE_PARSER=pdfextract to parse with a local checkout instead of the iDoc
# service. It produces the same Azure prebuilt-layout JSON, so the document
# pipeline, clause detection and coordinates all behave identically - the only
# difference is that nothing leaves the machine.
#
# Point this at the checkout directory itself (the one containing run_cli.py). Its
# own .venv is used, so the extractor's dependencies - pdfplumber, OpenCV, and the
# Tesseract and poppler binaries - stay out of this service.
PDFEXTRACT_PATH=
# baseline = pdfplumber + Tesseract, no models. docling = better on complex
# layouts, much heavier, and must be installed in the extractor's own venv.
PDFEXTRACT_BACKEND=baseline
# OCR render resolution. The extractor's own default is 400, which is slow on a
# long scanned agreement.
PDFEXTRACT_DPI=300
# Local, but not fast: OCR over a 100-page scan is minutes of CPU.
PDFEXTRACT_TIMEOUT_SECONDS=1800

# -----------------------------------------------------------------------------
# LLM / Inference (anthropic | openai | azure_openai | local | mock)
#
# `azure_openai` is the default and the only vendor this deployment is
# configured for. Azure addresses a DEPLOYMENT rather than a model name, so
# AZURE_OPENAI_DEPLOYMENT decides which model answers and the LLM_MODEL* values
# are not consulted on that path at all.
#
# `mock` needs no vendor account, no API key and no extra package: the platform
# runs end to end without one. The trade-off is that mock extractions are
# synthesised rather than read from the contract, so clause attributes and risk
# scores are demo-grade. Production refuses to boot on mock unless
# ALLOW_MOCK_AI=true states the choice deliberately.
# -----------------------------------------------------------------------------
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview
LLM_MODEL=gpt-4.1
# --- Model tiers -------------------------------------------------------------
# Every LLM call is routed to one of three tiers by task, not by call site - see
# app/ai/routing.py, which holds the whole task-to-tier table in one reviewable
# place. Nothing outside config and the routing table names a model.
#
#   simple    - extraction, classification, summarisation. Structured, high
#               volume, no reasoning required. This is most of the pipeline's
#               calls, so routing them here is where the cost saving comes from.
#   complex   - multi-document comparison, risk analysis, recommendations.
#   reasoning - genuine chain-of-thought: legal reasoning, ambiguity resolution.
#
# LLM_MODEL_REASONING falls back to LLM_MODEL_COMPLEX when unset - deliberately
# never to LLM_MODEL, which would send reasoning work to whatever the generic
# default happens to be.
LLM_MODEL_COMPLEX=claude-opus-5
# Model IDs are complete as written. Never append a date suffix - a dated variant
# such as `claude-haiku-4-5-20251001` is not a valid id and the request 404s.
LLM_MODEL_SIMPLE=claude-haiku-4-5
LLM_MODEL_REASONING=
LLM_MAX_OUTPUT_TOKENS=4096
# Streaming ceiling, used by the Copilot. Leave unset to take the built-in
# default, but note it must not exceed what your model accepts: a value above the
# model's limit makes every *streamed* answer fail while non-streaming still
# works, which reads as a broken Copilot rather than a number out of range. The
# provider now retries once at whatever ceiling the model names in its refusal,
# so this is a performance setting rather than a trap - set it anyway to avoid
# paying for the extra round trip.
#LLM_MAX_OUTPUT_TOKENS_STREAMING=32000
# Per-tier deadlines. A simple-tier extraction that has not answered inside its
# window is not going to, and holding a worker slot for the reasoning-tier
# timeout starves the pool behind it.
LLM_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS_SIMPLE=90
LLM_TIMEOUT_SECONDS_COMPLEX=300
LLM_MAX_RETRIES=3
# Base delay for the retry backoff. Full jitter is applied on top, so retries
# from concurrent workers do not re-converge on the limit they backed off from.
LLM_RETRY_BACKOFF_SECONDS=1.0
# NB: no LLM_TEMPERATURE. The setting does not exist; AI_EXTRACTION_TEMPERATURE
# applies to the extraction purpose only.

# -----------------------------------------------------------------------------
# Embeddings - Azure OpenAI
#
# NVIDIA Nemotron 3 Embed 1B is the platform's embedding model.
#
#   Dimension : 2048 (the model's real output width - verified at startup)
#   Storage   : halfvec, NOT vector. pgvector's HNSW index stops at 2000
#               dimensions for `vector`, so a vector(2048) column is created
#               happily and then cannot be indexed at all - every similarity
#               search silently degrades to a sequential scan. halfvec indexes to
#               4000 and halves storage.
#   Prefixes  : the model is asymmetric and expects `query:` on searches and
#               `passage:` on documents. The provider applies them; getting this
#               wrong costs recall without raising anything.
#   Matryoshka: EMBEDDING_DIM may be lowered to 1024 or 512, which slices the
#               vector and re-normalises it. Anything above 2048 is rejected -
#               vectors are never padded.
#
# Changing EMBEDDING_MODEL or EMBEDDING_DIM invalidates every stored vector.
# Run the migration, then `cip reindex-embeddings --all`.
# -----------------------------------------------------------------------------
# Azure OpenAI, on its own resource - embeddings routinely live apart from the
# chat model. Each AZURE_OPENAI_EMBEDDING_* value falls back to its
# AZURE_OPENAI_* counterpart when empty, so one resource for both needs none of
# the second group.
EMBEDDING_PROVIDER=azure_openai
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_STORAGE=halfvec
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_VERSION=v1
# Probe the provider during startup and refuse to boot on a broken configuration.
# Turn off for offline/local UI work, where a network round trip per boot is
# friction with no benefit.
EMBEDDING_VERIFY_ON_STARTUP=true

# Cross-encoder re-ranker. Off, and no model configured - retrieval falls back
# to score fusion.
RERANKER_ENABLED=false

# -----------------------------------------------------------------------------
# Retrieval / RAG tuning
# -----------------------------------------------------------------------------
RETRIEVAL_MAX_DOCUMENTS=25
RETRIEVAL_MAX_CLAUSES=40
RETRIEVAL_MAX_CHUNKS=60

# Cosine-similarity floor for a vector hit. Most specific setting wins:
#
#   1. the level's own variable, if set
#   2. RETRIEVAL_MIN_SIMILARITY, if set
#   3. otherwise the built-in per-level defaults: 0.35 / 0.45 / 0.40
#
# So setting only RETRIEVAL_MIN_SIMILARITY moves all three levels together, and
# a per-level variable overrides it for that level alone. Set nothing and you get
# the tuned defaults, which differ by level on purpose: a clause is short and
# formulaic, so boilerplate scores high against everything and needs a stricter
# floor than a long, topical document summary.
#
# Lower these if relevant text is being cut before it reaches the answer; raise
# them if unrelated text is getting through.
RETRIEVAL_MIN_SIMILARITY=0.25
# Per-level overrides, commented out so the defaults above apply. Either spelling
# works - RETRIEVAL_DOCUMENT_MIN_SIMILARITY is accepted as an alias for each.
#RETRIEVAL_MIN_SIMILARITY_DOCUMENT=0.35
#RETRIEVAL_MIN_SIMILARITY_CLAUSE=0.45
#RETRIEVAL_MIN_SIMILARITY_CHUNK=0.40

RETRIEVAL_TIMEOUT_SECONDS=20
RERANK_TOP_K=20
CONTEXT_TOKEN_BUDGET=24000

# Copilot query pipeline.
#
# The document-type threshold is high on purpose: filtering to the wrong type
# removes the answer outright, while not filtering only widens the search.
COPILOT_DOCTYPE_CONFIDENCE_THRESHOLD=0.75
# Answer-level guardrail. Distinct from RETRIEVAL_MIN_SIMILARITY, which decides
# what retrieval returns; this decides whether the best of it is good enough to
# answer from at all.
COPILOT_SIMILARITY_THRESHOLD=0.45
COPILOT_TOP_K=25
COPILOT_CONTEXT_CHUNKS=8

# Retrieval audit retention.
#
# A question about a contract can carry counterparty names and deal terms. Set
# STORE_QUERY_TEXT=false where that cannot be retained - every other field on the
# row (strategy, similarity, latency, cost) still works without it.
RETRIEVAL_AUDIT_STORE_QUERY_TEXT=true
RETRIEVAL_AUDIT_RETENTION_DAYS=180
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=80
# Iterative scan (pgvector 0.8+). Required, not optional, once the table holds
# more than one project: every similarity query carries filters the index cannot
# use (project, contract, model, metadata), so a single-pass scan returns the
# globally-nearest rows and then discards the ones outside the caller's scope -
# which at scale means returning nothing for questions that have a perfect answer.
# Set to `off` only on a pgvector older than 0.8, where the SET is ignored anyway.
HNSW_ITERATIVE_SCAN=relaxed_order
HNSW_MAX_SCAN_TUPLES=20000

# -----------------------------------------------------------------------------
# Queue (BullMQ dispatch shim -> Python stage services)
# -----------------------------------------------------------------------------
# bullmq   - the Node dispatcher over Redis. Needs the `queue` service and Redis.
# postgres - the stage_queue table, claimed with FOR UPDATE SKIP LOCKED. Needs
#            neither; run `python -m app.cli worker` instead of the queue service.
# arq      - enqueues to a Redis list that nothing consumes. Not usable.
QUEUE_DRIVER=bullmq
QUEUE_PREFIX=cip
# Python orchestrator -> Node dispatcher (enqueue)
QUEUE_DISPATCHER_URL=http://queue:9100
# Node dispatcher -> Python stage services (execute)
INTERNAL_API_BASE_URL=http://backend:8000
# Shared secret the Node shim presents to the Python internal stage endpoints.
INTERNAL_API_TOKEN=change-me-internal-token
QUEUE_STAGE_TIMEOUT_MS=1800000
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000
QUEUE_DLQ_NAME=dead-letter

# Worker pool concurrency baselines (§10.4). One entry per stage in STAGE_ORDER.
#
# DOCPIPELINE and EXTRACTION are capped far below the rest on purpose: each makes
# a dozen or more model calls per document, so running more documents in parallel
# does not finish them sooner - it queues them behind the same provider gateway
# and makes rate limiting more likely.
#
# The retired stages (ENRICHMENT, CLASSIFICATION, CHUNKING, AI_EXTRACTION) used to
# be listed here and the two live AI stages were not, which meant the only knobs
# on offer were for stages nothing dispatches.
# Run the periodic maintenance sweeps inside each worker - stalled-job
# reclamation, export recovery and purge, alert evaluation. On by default, which is
# what removes the `scheduler` service from compose. A Postgres advisory lock keeps
# them to one worker per tick however many are running.
#
# Turn off only when a standalone `python -m app.cli scheduler` runs them instead.
# Off with nothing else running them loses alert evaluation entirely: expiry and
# renewal deadlines are noticed by nothing else.
WORKER_MAINTENANCE=true

WORKER_CONCURRENCY_VALIDATION=10
WORKER_CONCURRENCY_PARSER=20
WORKER_CONCURRENCY_DOCPIPELINE=4
WORKER_CONCURRENCY_EXTRACTION=4
WORKER_CONCURRENCY_EMBEDDING=15
WORKER_CONCURRENCY_INDEXING=5
WORKER_CONCURRENCY_EXPORT=4

# -----------------------------------------------------------------------------
# Alerts engine
# -----------------------------------------------------------------------------
ALERT_EXPIRY_WINDOW_DAYS=90
ALERT_RISK_SCORE_CUTOFF=67
ALERT_EVALUATOR_INTERVAL_MINUTES=60

# -----------------------------------------------------------------------------
# Operational alert delivery (docs/alerting.md)
#
# Where an operational failure is *sent*, as opposed to the evaluator above which
# decides which contract alerts are *raised*. Every alert is persisted to the
# `alerts` table regardless; this block only governs notification.
#
# `console` is the default because it needs no credentials, no network and no
# vendor account - so the stack starts and processes documents with nothing
# configured here. A typo in ALERT_PROVIDER or ALERT_MIN_LEVEL fails the boot
# rather than producing alerts that silently never arrive.
# -----------------------------------------------------------------------------
ALERT_ENABLED=true
# CSV. console | slack | teams | webhook | email | null
#   e.g. ALERT_PROVIDER=console,slack
ALERT_PROVIDER=console
# INFO | WARNING | ERROR | CRITICAL. Below this, nothing is delivered.
ALERT_MIN_LEVEL=ERROR

ALERT_TIMEOUT_SECONDS=10
ALERT_RETRY_ATTEMPTS=3
ALERT_RETRY_BACKOFF_SECONDS=0.5
ALERT_RETRY_BACKOFF_MAX_SECONDS=8

SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# Generic JSON receiver: PagerDuty Events, Opsgenie, an internal bus.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# CSV of recipients.
SMTP_TO=
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Human review thresholds (§13)
# -----------------------------------------------------------------------------
REVIEW_CONFIDENCE_THRESHOLD=0.85

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_SERVICE_NAME=cip-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
