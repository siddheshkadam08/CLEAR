# Without this, `COPY . .` ships ~256 MB of node_modules into the build context
# and the image, only for the next layer to overwrite it from the deps stage.
# The build goes from minutes to seconds.
node_modules
dist
.vite
coverage

# Never bake local configuration or secrets into an image.
.env
.env.*
!.env.example

# A host-built tsbuildinfo makes `tsc -b` inside the image believe the project is
# already up to date, so `npm run typecheck` reports success having checked
# nothing - the one thing that step exists to prevent. Type errors then reach the
# bundle, which Vite emits regardless because it never typechecks.
*.tsbuildinfo

.git
.gitignore
*.log
npm-debug.log*
.DS_Store
Thumbs.db
