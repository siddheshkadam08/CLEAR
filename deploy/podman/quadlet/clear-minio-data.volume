# Object storage data. Mounted at /data in the MinIO container.
#
# THE most important volume on this host after the database. It holds the bytes of
# every uploaded contract and every generated export. The `documents` rows in
# Postgres carry a `storage_path` pointing into it, so losing this volume does not
# empty the application - it leaves a full-looking application whose every
# document download 404s, which is worse.
#
# If the container is deleted: the data survives. `podman rm clear-minio` is safe;
# `podman volume rm clear-minio-data` is not.
#
# Backup (see deploy/podman/scripts/backup.sh):
#   podman volume export clear-minio-data --output clear-minio-$(date +%F).tar
# Restore:
#   podman volume import clear-minio-data clear-minio-2026-08-12.tar
#
# The backup must be taken together with the Postgres dump, and restored together
# with it. A database newer than the object store points at objects that do not
# exist; an object store newer than the database holds orphans nothing can reach.
#
# Installed to:  ~/.config/containers/systemd/clear-minio-data.volume
# Generates:     clear-minio-data-volume.service
[Unit]
Description=CLEAR object storage data (MinIO)

[Volume]
VolumeName=clear-minio-data

[Install]
WantedBy=default.target
