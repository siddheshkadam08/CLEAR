# MinIO - object storage for uploaded contracts and generated exports.
#
# Containerised deliberately, unlike Postgres: its data lives in a podman volume
# that outlives the container, it has no host package to install, and swapping it
# for a managed S3 or Azure Blob endpoint later is a change to three environment
# variables and the removal of this unit.
#
# Two things about how it is reached
# ----------------------------------
# * The application reaches it as `clear-minio:9000` on the podman network.
# * A browser cannot resolve that name, so presigned download URLs are signed for
#   S3_PUBLIC_ENDPOINT_URL instead and proxied to here by the frontend's nginx.
#   That proxy forwards $http_host unchanged, because SigV4 signs the Host header
#   INCLUDING the port - forward a host that differs by so much as the port and
#   MinIO computes a different signature and rejects every download with
#   SignatureDoesNotMatch.
#
# The published port is loopback-only: it exists for `mc`, backups and debugging
# from the VM itself. The browser never uses it.
#
# Credentials come from a file of their own rather than from clear.env, so the
# object store does not receive every LLM key the backend holds.
#
# Installed to:  ~/.config/containers/systemd/clear-minio.container
# Generates:     clear-minio.service
[Unit]
Description=CLEAR object storage (MinIO)
After=network-online.target

[Container]
Image=@MINIO_IMAGE@
ContainerName=clear-minio
Network=clear.network
Volume=clear-minio-data.volume:/data
EnvironmentFile=@MINIO_ENV_FILE@

# 127.0.0.1 only. Publishing 9000 on 0.0.0.0 would put the object store on the
# public interface next to the site it serves.
PublishPort=127.0.0.1:9000:9000
PublishPort=127.0.0.1:9001:9001

Exec=server /data --console-address :9001

HealthCmd=mc ready local
HealthInterval=15s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=15s

NoNewPrivileges=true
LogDriver=journald

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
