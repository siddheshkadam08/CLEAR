# Creates the object-storage bucket the application writes to.
#
# Separate from clear-minio.service because MinIO has no "create this bucket on
# start" option, and separate from the backend because the backend does not create
# it either - it assumes the bucket exists, and a missing one surfaces as every
# upload failing at the storage step rather than as anything about a bucket.
#
# Idempotent (`mc mb --ignore-existing`), so it runs on every boot and costs a
# second.
#
# Installed to:  ~/.config/systemd/user/clear-minio-init.service
[Unit]
Description=CLEAR object storage bucket provisioning
After=clear-minio.service
Requires=clear-minio.service

[Service]
Type=oneshot
RemainAfterExit=yes

# MinIO accepts connections a moment after the container starts; the script polls
# rather than sleeping a fixed amount.
Restart=on-failure
RestartSec=10
StartLimitBurst=10
TimeoutStartSec=300

ExecStart=@INSTALL_DIR@/scripts/minio-init.sh

[Install]
WantedBy=default.target
