### =============================================================================
### CLEAR - production environment for the Podman deployment
###
###   cp .env.production.example /etc/clear/clear.env
###   chmod 600 /etc/clear/clear.env      # it holds every secret the stack has
###
### Every container is started with `--env-file` pointing at the *deployed* copy
### of this file. That is deliberate and it is the one structural difference from
### `docker-compose.yml`: compose forwards only the keys named in its
### `x-backend-env` block, so a key set in `.env` but missing from that block is
### silently dropped and the symptom looks like a code fault. `--env-file` has no
### allow-list - what is in this file is what the process sees.
###
### Podman `--env-file` parsing rules, which differ from a shell:
###   * `KEY=value`, one per line. No `export`.
###   * Do NOT quote values. `CORS_ORIGINS="https://x"` sets the value to
###     `"https://x"` including the quotes, and the CORS check then never matches.
###   * No `$VAR` interpolation. Write the value out in full.
###   * `#` starts a comment only at the beginning of a line.
###
### Lines marked  <<< SET THIS  have no usable default. Lines marked
### <<< REQUIRES CONFIRMATION depend on facts about your VM or your vendor
### accounts that cannot be derived from this repository.
### =============================================================================


### -----------------------------------------------------------------------------
### 1. Application
### -----------------------------------------------------------------------------
APP_NAME=CLEAR
# `production` turns on the guard in app/core/config.py::_guard_production, which
# REFUSES TO BOOT on: a default JWT_SECRET or INTERNAL_API_TOKEN, the documented
# seed passwords, `*` in CORS_ORIGINS, DEBUG=true, STORAGE_PROVIDER=local,
# mock AI providers without ALLOW_MOCK_AI, and IDOC_VERIFY_TLS=false.
# It also disables /docs, /redoc and /openapi.json.
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
API_V1_PREFIX=/api/v1

# The browser origin. The SPA and the API are same-origin (nginx proxies /api),
# so this matters only for a client that is not served by this deployment's
# nginx. `*` is refused in production.
# <<< REQUIRES CONFIRMATION - your public hostname
CORS_ORIGINS=https://clear.example.com

ORGANIZATION_NAME=IRIS RegTech


### -----------------------------------------------------------------------------
### 2. PostgreSQL - installed directly on the VM, NOT containerised
### -----------------------------------------------------------------------------
# The address the *containers* use to reach the host's Postgres. `localhost` is
# the container itself and will fail; see PODMAN_DEPLOYMENT.md §6 for how to find
# the right value and why `host.containers.internal` is not the default here.
POSTGRES_HOST=172.22.20.132
POSTGRES_PORT=5432
POSTGRES_DB=cip
POSTGRES_USER=cip
# <<< SET THIS - openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=

# The application reads DATABASE_URL, not the POSTGRES_* parts. Both are listed
# because the POSTGRES_* values are what the psql/pg_dump commands in the guide
# use; keep them consistent by hand. `+asyncpg` is optional - the settings layer
# normalises the DSN onto asyncpg for the app and onto psycopg for Alembic.
# <<< SET THIS - same user/password/host/db as above
DATABASE_URL=postgresql+asyncpg://cip:CHANGE_ME@172.22.20.132:5432/cip

# Empty means `public`. Set this only when the database is shared with another
# application that already owns table names this one uses (`contracts`,
# `clauses`). A dedicated schema isolates the two with no code change.
DB_SCHEMA=

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=60000
# Must exceed the slowest stage. A stage runs in one transaction and the AI
# extraction stage spends minutes in provider calls with that transaction open,
# so the connection is idle *in transaction* throughout. Set this too low and
# Postgres kills the session mid-extraction; the job then reports "no clauses
# could be identified", which points at prompts rather than at the database.
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=1800000


### -----------------------------------------------------------------------------
### 3. Redis - containerised, internal only
### -----------------------------------------------------------------------------
# `clear-redis` is the container name on the `clear-net` podman network.
REDIS_URL=redis://clear-redis:6379/0
REDIS_CACHE_DB=1
CACHE_TTL_SECONDS=300


### -----------------------------------------------------------------------------
### 4. Secrets
### -----------------------------------------------------------------------------
# <<< SET THIS - openssl rand -hex 32
JWT_SECRET=
# Authenticates the queue dispatcher and the worker pools to the internal stage
# endpoints. Not a user credential; it must still be unguessable.
# <<< SET THIS - openssl rand -hex 32
INTERNAL_API_TOKEN=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# The first administrator, created by `cli migrate --seed`. Both defaults are
# refused in production.
SEED_ADMIN_EMAIL=admin@example.com
# <<< SET THIS - anything but Abc@1234
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_FORCE_PASSWORD_CHANGE=true
# Initial password for accounts an administrator creates in the UI. Also refused
# at its documented default.
# <<< SET THIS - anything but Abc@1234
NEW_USER_DEFAULT_PASSWORD=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=10/minute


### -----------------------------------------------------------------------------
### 5. Microsoft Entra SSO - optional
### -----------------------------------------------------------------------------
# Leave false and the stack uses local password authentication only. Turning this
# on also needs VITE_ENABLE_MICROSOFT_SSO=true at *frontend build time* - it is a
# Vite variable, baked into the bundle, so it cannot be changed by editing this
# file on the VM.
OIDC_ENABLED=false
OIDC_PROVIDER=microsoft
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
# Empty for a public (PKCE) registration.
AZURE_AD_CLIENT_SECRET=
# Both must be addresses a *browser* can reach, and the redirect URI must be
# registered on the app registration byte for byte.
OIDC_REDIRECT_URI=https://clear.example.com/api/v1/auth/oidc/callback
OIDC_POST_LOGIN_REDIRECT=https://clear.example.com/auth/callback
OIDC_SILENT_FIRST=true
OIDC_AUTO_PROVISION_USERS=true
OIDC_SCOPES=openid profile email
OIDC_ALLOWED_EMAIL_DOMAINS=


### -----------------------------------------------------------------------------
### 6. Document storage - local filesystem
### -----------------------------------------------------------------------------
# There is no object store in this deployment. Document bytes live on a podman
# volume (`clear-storage`) mounted into the API and both worker pools, and the
# browser never touches storage directly: the viewer and every download go
# through GET /api/v1/contracts/{contract_id}/content, which streams from the
# storage adapter with the request's own authorisation applied.
#
# The local adapter's `signed_url()` returns an API-relative path rather than a
# real signed URL - there is nothing to sign against - and ContractService
# rewrites it onto the /content route. So downloads are same-origin through the
# existing /api/ proxy, with no second upstream and no bucket name in the URL.
STORAGE_PROVIDER=local

# Where the bytes go. Must match the container path the `clear-storage` volume is
# mounted at in clear-backend, clear-worker-parser and clear-worker-ai - all three
# read and write the same files, so a value that disagrees with any one of them
# produces a document the uploader can see and a worker cannot.
STORAGE_LOCAL_ROOT=/var/lib/cip/storage

# A SUBDIRECTORY under STORAGE_LOCAL_ROOT, not a bucket. Files land at
# STORAGE_LOCAL_ROOT/STORAGE_CONTAINER/<key>, and `documents.storage_path` in the
# database is stored relative to that pair.
#
# DO NOT CHANGE IT AFTER THE FIRST UPLOAD. Existing rows keep pointing at the old
# subdirectory, so every previously uploaded document 404s in the viewer while the
# row insists it exists - and nothing logs a cause, because the lookup is a plain
# file-not-found under a path nobody is looking at.
#
# It no longer has to avoid colliding with an SPA route: that constraint came from
# the bucket name becoming an nginx `location`, and there is no such proxy now.
STORAGE_CONTAINER=contracts

# Inert under `local` - kept because switching STORAGE_PROVIDER to s3 or azure
# needs it and nothing else in this file.
STORAGE_SIGNED_URL_TTL_SECONDS=3600


### -----------------------------------------------------------------------------
### 7. Uploads
### -----------------------------------------------------------------------------
ALLOWED_FILE_TYPES=pdf,doc,docx,zip
# Keep at or below whatever the parser accepts, so an oversized file is refused
# at upload rather than after it has been stored and queued. The nginx
# client_max_body_size in front of the API must be larger than this.
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=100
# DOC/DOCX conversion uses LibreOffice, which is installed in the backend image.
# Empty means "search PATH and the usual locations", which is correct there.
LIBREOFFICE_PATH=
CONVERSION_TIMEOUT_SECONDS=180
MAX_ARCHIVE_MEMBERS=500
MAX_ARCHIVE_UNCOMPRESSED_MB=2048
# Reject a re-upload of a file already present in the project.
UPLOAD_DUPLICATE_CHECK=true
VIRUS_SCAN_ENABLED=false


### -----------------------------------------------------------------------------
### 8. Document parsing
### -----------------------------------------------------------------------------
# `pdfextract` is this deployment: the self-hosted extractor, reached over HTTP at
# PDFEXTRACT_URL. `idoc` calls the hosted layout service instead. `pymupdf` is a
# local fallback and is DEGRADED - it returns no layout JSON, so the
# document-pipeline stage cannot run and clauses lose their page coordinates.
ACTIVE_PARSER=pdfextract
# `live` calls the parser. `fixture` replays a recorded response and is for
# offline development only - in production it fails every document it has not
# already seen.
PARSER_MODE=live
# Off deliberately: it writes the full extracted text of every uploaded contract
# to disk, for ever.
PARSER_RECORD_FIXTURES=false
PARSER_TIMEOUT_SECONDS=600
PARSER_MAX_RETRIES=2

# --- ACTIVE_PARSER=idoc (unused while ACTIVE_PARSER=pdfextract) ---
IDOC_ENDPOINT=https://devidocapi2.iriscarbon.com/pdf/upload-pdf-to-json
# <<< REQUIRES CONFIRMATION - required if the endpoint authenticates
IDOC_API_KEY=
IDOC_API_KEY_HEADER=X-API-Key
IDOC_TIMEOUT_SECONDS=600
# Contract text is uploaded to this service, so an unverified certificate would
# make that upload interceptable. `false` is refused in production.
IDOC_VERIFY_TLS=true

# --- ACTIVE_PARSER=pdfextract - the parser this deployment uses ---
# `clear-extractor` is the extractor container's name on the `clear-net` podman
# network, and 8000 is the port it listens on INSIDE that network. It is not the
# 127.0.0.1:58001 the host publishes for operators: that address does not exist
# from inside a container, and using it here makes every parse fail with a
# connection refusal that names the loopback rather than the mistake.
#
# The extractor is built and released from a SEPARATE repository - this deployment
# does not build its image. See PODMAN_DEPLOYMENT.md §20.
PDFEXTRACT_URL=http://clear-extractor:8000
PDFEXTRACT_TIMEOUT_SECONDS=1800
# The subprocess path. Leave EMPTY in a container: it needs a mounted checkout
# whose virtualenv was built for this image's platform.
PDFEXTRACT_PATH=
PDFEXTRACT_BACKEND=baseline
PDFEXTRACT_DPI=300

OCR_ENABLED=true
OCR_ENGINE=tesseract
TESSERACT_CMD=/usr/bin/tesseract
OCR_SCANNED_PAGE_CHAR_THRESHOLD=100


### -----------------------------------------------------------------------------
### 9. Inference (LLM)
### -----------------------------------------------------------------------------
# gemini | anthropic | openai | azure_openai | mock
# `mock` SYNTHESISES extractions rather than reading them from the contract, so
# production refuses it unless ALLOW_MOCK_AI=true is set deliberately.
# <<< REQUIRES CONFIRMATION - which vendor account this deployment has
LLM_PROVIDER=gemini
ALLOW_MOCK_AI=false

# All three tiers must carry a model id the chosen provider accepts. A tier left
# at its Anthropic-native default is rejected outright by a gateway such as
# OpenRouter (`<model> is not a valid model ID`), and the simple tier is most of
# the pipeline.
LLM_MODEL=gemini-2.5-flash
LLM_MODEL_SIMPLE=gemini-2.5-flash-lite
LLM_MODEL_COMPLEX=gemini-2.5-flash
# Empty falls back to LLM_MODEL_COMPLEX.
LLM_MODEL_REASONING=

LLM_MAX_OUTPUT_TOKENS=4096
# Empty means "not configured", so the built-in applies. A ceiling above the
# model's own limit fails every streamed Copilot answer while non-streaming keeps
# working.
LLM_MAX_OUTPUT_TOKENS_STREAMING=
LLM_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS_SIMPLE=90
LLM_TIMEOUT_SECONDS_COMPLEX=300
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.0
# `none` for models behind an OpenAI-compatible gateway that does not implement
# the strict json_schema response format.
LLM_STRUCTURED_OUTPUT=json_schema

# --- credentials: fill in only the block matching LLM_PROVIDER ---
# gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_SIMPLE=gemini-2.5-flash-lite
# anthropic
ANTHROPIC_API_KEY=
# openai, or any OpenAI-compatible gateway
OPENAI_API_KEY=
# Empty means api.openai.com. Point it at a gateway (OpenRouter, vLLM, ...) here;
# setting only the key sends every request to OpenAI, which fails with "Incorrect
# API key provided" and reads like a bad key rather than a missing base URL.
OPENAI_BASE_URL=
# azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=


### -----------------------------------------------------------------------------
### 10. Embeddings
### -----------------------------------------------------------------------------
# nvidia | openai | azure_openai | sentence_transformers | mock
# `mock` produces vectors with no semantic meaning, so semantic search and the
# Copilot silently return nothing useful. Refused in production without
# ALLOW_MOCK_AI.
#
# `sentence_transformers` needs an image built with the `local-ml` extra (torch);
# the shipped image is NOT built with it.
# <<< REQUIRES CONFIRMATION
EMBEDDING_PROVIDER=azure_openai
EMBEDDING_MODEL=text-embedding-3-small
# Must equal the model's real output width AND the width of the vector column in
# the database. A mismatch degrades every answer silently, which is why the
# backend probes it at startup and refuses to boot on a disagreement.
EMBEDDING_DIM=1536
# `halfvec` is required, not preferred, above 2000 dimensions: pgvector's HNSW
# index stops at 2000 for the `vector` type, so a wider column cannot be indexed
# and every similarity search becomes a sequential scan.
EMBEDDING_STORAGE=halfvec
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=60
# Leave ON. It is the check that turns a silent quality regression into a refusal
# to start. Turning it off to "get past" a boot failure ships broken retrieval.
EMBEDDING_VERIFY_ON_STARTUP=true

# --- credentials: fill in only the block matching EMBEDDING_PROVIDER ---
# azure_openai. Separate from the chat block because embeddings routinely live on
# a different resource; each value falls back to its AZURE_OPENAI_* equivalent.
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01
# nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1


### -----------------------------------------------------------------------------
### 11. Retrieval tuning
### -----------------------------------------------------------------------------
# Blank means "not configured", which leaves the tuned per-level defaults
# (0.35 document / 0.45 clause / 0.40 chunk) in place. Setting the base value
# flattens all three onto it, so leave it blank unless that is the intent.
RETRIEVAL_MIN_SIMILARITY=
RETRIEVAL_MIN_SIMILARITY_DOCUMENT=
RETRIEVAL_MIN_SIMILARITY_CLAUSE=
RETRIEVAL_MIN_SIMILARITY_CHUNK=
RETRIEVAL_MAX_DOCUMENTS=25
RETRIEVAL_MAX_CLAUSES=40
RETRIEVAL_MAX_CHUNKS=20
RETRIEVAL_TIMEOUT_SECONDS=20
RERANK_TOP_K=20
CONTEXT_TOKEN_BUDGET=24000
COPILOT_SIMILARITY_THRESHOLD=0.45
COPILOT_DOCTYPE_CONFIDENCE_THRESHOLD=0.75
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40


### -----------------------------------------------------------------------------
### 12. Queue and workers
### -----------------------------------------------------------------------------
# `bullmq` is this deployment: Redis plus the Node dispatcher, which POSTs each
# stage to a worker pool's internal HTTP endpoint.
#
# `postgres` is the alternative for a host too small for Redis and a Node
# process: stages are claimed from the `stage_queue` table instead. It needs a
# DIFFERENT worker command - `python -m app.cli worker`, not
# `uvicorn app.worker_app:app` - because worker_app serves the dispatcher's
# endpoints and polls nothing. Getting that pair wrong leaves every upload
# `pending` for ever while the containers report healthy.
QUEUE_DRIVER=bullmq
QUEUE_PREFIX=cip
QUEUE_DISPATCHER_URL=http://clear-queue:9100
INTERNAL_API_BASE_URL=http://clear-backend:8000
QUEUE_STAGE_TIMEOUT_MS=1800000
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000
QUEUE_DLQ_NAME=dead-letter

# The periodic sweeps - alert evaluation, stalled-job reclamation, export
# recovery and purge - run inside every worker behind a Postgres advisory lock,
# so exactly one performs them per tick. Setting this false in every worker and
# running no standalone `cli scheduler` means alerts are never evaluated and
# stalled jobs are never reclaimed, silently.
WORKER_MAINTENANCE=true

# The two AI stages are capped low because each makes a dozen or more model calls
# per document; more parallel documents just queue behind the same gateway.
WORKER_CONCURRENCY_VALIDATION=10
WORKER_CONCURRENCY_PARSER=20
WORKER_CONCURRENCY_DOCPIPELINE=4
WORKER_CONCURRENCY_EXTRACTION=4
WORKER_CONCURRENCY_EMBEDDING=15
WORKER_CONCURRENCY_INDEXING=5
WORKER_CONCURRENCY_EXPORT=4


### -----------------------------------------------------------------------------
### 13. Alerting
### -----------------------------------------------------------------------------
ALERT_ENABLED=true
ALERT_EXPIRY_WINDOW_DAYS=90
ALERT_RISK_SCORE_CUTOFF=70
ALERT_EVALUATOR_INTERVAL_MINUTES=60
# none | slack | teams | webhook | smtp
ALERT_PROVIDER=none
ALERT_MIN_LEVEL=warning
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

REVIEW_CONFIDENCE_THRESHOLD=0.85


### -----------------------------------------------------------------------------
### 14. Filesystem paths inside the containers
### -----------------------------------------------------------------------------
# Both live under the `clear-storage` volume, alongside the documents themselves -
# see §6, which sets STORAGE_LOCAL_ROOT to the same mount point. It is set there
# and only there: `--env-file` lets the LAST assignment of a key win silently, so a
# second copy here would quietly override anyone editing §6.
#
# EVALUATION_RESULTS_DIR must be absolute and on that volume. The default is the
# RELATIVE `evaluation-results`, which the benchmark CLI writes relative to its
# working directory and the API reads relative to its own - so the Retrieval
# Quality screen reports "no benchmark has been recorded" while the files sit one
# directory away, with no error anywhere.
EVALUATION_RESULTS_DIR=/var/lib/cip/storage/evaluation-results
PARSER_FIXTURE_DIR=/var/lib/cip/storage/fixtures/parser


### -----------------------------------------------------------------------------
### 15. Observability
### -----------------------------------------------------------------------------
# No collector container is part of this deployment. Leaving this true without
# one makes every span export attempt fail and retry in the background.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
# Prometheus text on GET /metrics. Not published publicly - the frontend nginx
# does not proxy it, so it is reachable only from the podman network or by
# `podman exec`.
METRICS_ENABLED=true


### -----------------------------------------------------------------------------
### 16. Frontend build arguments - NOT read from this file at runtime
### -----------------------------------------------------------------------------
# Vite substitutes `import.meta.env` at BUILD time, so these are baked into the
# bundle when the frontend image is built. Changing them here and restarting the
# container does nothing. They are listed so one file records the whole
# configuration; `build-images.sh` reads them from here when it builds.
#
# `/api/v1` keeps the browser same-origin, so nginx proxies the API and the
# HttpOnly refresh cookie stays first-party. Pointing this at a bare host:port
# makes every API call cross-origin and puts that cookie at the mercy of
# SameSite=None plus CORS credentials.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=CLEAR
VITE_ENABLE_MICROSOFT_SSO=false
