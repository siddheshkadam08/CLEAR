{
  "name": "cip-queue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Logic-free BullMQ dispatch layer. Every decision is made in Python; this only moves messages.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
